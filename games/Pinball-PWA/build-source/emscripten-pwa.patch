+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+// Called from the PWA's on-screen touch controls: injects a key press/release
+// into SDL's event queue so it follows the same path as a physical keyboard.
+#include "options.h"
+// action: 0 left flipper, 1 right flipper, 2 plunger, 3 nudge left,
+//         4 nudge right, 5 nudge up, 10 new game (F2), 11 pause (F3)
+extern "C" EMSCRIPTEN_KEEPALIVE void web_key(int action, int down)
+{
+	int sdlKey;
+	switch (action)
+	{
+	case 0: sdlKey = options::Options.LeftFlipperKey; break;
+	case 1: sdlKey = options::Options.RightFlipperKey; break;
+	case 2: sdlKey = options::Options.PlungerKey; break;
+	case 3: sdlKey = options::Options.LeftTableBumpKey; break;
+	case 4: sdlKey = options::Options.RightTableBumpKey; break;
+	case 5: sdlKey = options::Options.BottomTableBumpKey; break;
+	case 10: sdlKey = SDLK_F2; break;
+	case 11: sdlKey = SDLK_F3; break;
+	default: return;
+	}
+	SDL_Event ev{};
+	ev.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+	ev.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+	ev.key.repeat = 0;
+	ev.key.keysym.sym = sdlKey;
+	ev.key.keysym.scancode = SDL_GetScancodeFromKey(sdlKey);
+	SDL_PushEvent(&ev);
+}
+#endif
