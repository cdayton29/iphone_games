+// Compact layout: draw the playfield as large as the window allows (it fills the
+// limiting dimension) and show only the Ball and Score boxes from the side panel.
+// Portrait: a slim [BALL n][score] strip above the table. Landscape: the two boxes
+// stacked beside the table. Whichever arrangement yields the bigger table wins.
+static void PresentCompact(SDL_Texture* tex)
+{
+	auto renderer = winmain::Renderer;
+	int W, H;
+	SDL_GetRendererOutputSize(renderer, &W, &H);
+
+	const auto& vs = render::vscreen;
+	const float sx = vs.Width / 600.0f, sy = vs.Height / 416.0f; // measured at 640x480
+	auto R = [&](int x, int y, int w, int h)
+	{
+		return SDL_Rect{int(x * sx), int(y * sy), int(w * sx), int(h * sy)};
+	};
+	const int tw = pb::MainTable->Width, th = vs.Height;
+	const SDL_Rect tableSrc{0, 0, tw, th};
+	const SDL_Rect ball = R(490, 147, 91, 38), score = R(428, 189, 154, 38);
+	const float g = 4 * sx;
+	const float pad = 4.0f * ImGui::GetIO().FontGlobalScale;
+	// window -> output pixel ratio, for the CSS-pixel safe-area insets
+	int ww, wh;
+	SDL_GetWindowSize(winmain::MainWindow, &ww, &wh);
+	const float px = ww > 0 ? static_cast<float>(W) / ww : 1.0f;
+	const float iL = fullscrn::SafeInsets[0] * px, iT = fullscrn::SafeInsets[1] * px,
+	            iR = fullscrn::SafeInsets[2] * px, iB = fullscrn::SafeInsets[3] * px;
+	const float availW = W - iL - iR - pad * 2, availH = H - iT - iB - pad * 2;
+
+	// Landscape: table, then a column with ball over score
+	const float colW = std::max(ball.w, score.w), colH = ball.h + g + score.h;
+	const float k = 0.8f;
+	const float sL = std::min(availH / th, (availW - pad) / (tw + k * colW));
+	// Portrait: strip [ball][score] on top, table underneath
+	const float stripW = ball.w + g + score.w, stripH = static_cast<float>(score.h);
+	float sP = std::min(availW / tw, (availH - pad) / (th + stripH));
+	const float sS = std::min(sP, availW / stripW);
+	sP = std::min(availW / tw, (availH - pad - stripH * sS) / th);
+
+	auto copy = [&](const SDL_Rect& src, float x, float y, float s)
+	{
+		SDL_Rect dst{int(x), int(y), int(src.w * s + 0.5f), int(src.h * s + 0.5f)};
+		SDL_RenderCopy(renderer, tex, &src, &dst);
+	};
+
+	if (sL >= sP)
+	{
+		const float sT = sL, sC = sL * k;
+		const float groupW = tw * sT + pad + colW * sC;
+		const float x0 = iL + pad + (availW - groupW) / 2, y0 = iT + pad + (availH - th * sT) / 2;
+		copy(tableSrc, x0, y0, sT);
+		const float cx = x0 + tw * sT + pad;
+		copy(ball, cx + (colW - ball.w) * sC, y0, sC);
+		copy(score, cx + (colW - score.w) * sC, y0 + (ball.h + g) * sC, sC);
+	}
+	else
+	{
+		const float sT = sP;
+		// centre the strip + table vertically
+		const float groupH = stripH * sS + pad + th * sT;
+		const float y0 = iT + pad + std::max(0.0f, (availH - groupH) / 2);
+		const float x0 = iL + pad + (availW - stripW * sS) / 2;
+		copy(ball, x0, y0, sS);
+		copy(score, x0 + (ball.w + g) * sS, y0, sS);
+		copy(tableSrc, iL + pad + (availW - tw * sT) / 2, y0 + stripH * sS + pad, sT);
+	}
+}
+
 void render::PresentVScreen()
 {
 	BlitVScreen();
-	SDL_RenderCopy(winmain::Renderer, vScreenTex, nullptr, &DestinationRect);
+	if (options::Options.CompactLayout && pb::MainTable)
+		PresentCompact(vScreenTex);
+	else
+		SDL_RenderCopy(winmain::Renderer, vScreenTex, nullptr, &DestinationRect);
 }
